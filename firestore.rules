rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Consulta pública usuário -> e-mail para "esqueci a senha". Só leitura
    // por documento (sem list) e criação única pelo dono da conta.
    match /usernames/{storeName} {
      allow get: if true;
      allow create: if request.auth != null
        && storeName.matches('^[a-z0-9][a-z0-9._-]{1,28}[a-z0-9]$')
        && request.resource.data.keys().hasOnly(['email', 'uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email is string
        && request.resource.data.email.lower() == request.auth.token.email.lower()
        && request.resource.data.createdAt == request.time;
      allow list, update, delete: if false;
    }

    match /stores/{storeId} {
      function ownsStore() {
        return request.auth != null && request.auth.uid == storeId;
      }

      allow create: if ownsStore()
        && request.resource.data.keys().hasAll(['storeName', 'email', 'createdAt'])
        && request.resource.data.storeName is string
        && request.resource.data.storeName.matches('^[a-z0-9][a-z0-9._-]{1,28}[a-z0-9]$')
        && request.auth.token.email.lower() == request.resource.data.email.lower()
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.createdAt == request.time;
      allow get: if ownsStore();
      allow update: if ownsStore()
        && request.resource.data.storeName == resource.data.storeName
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254;
      // Busca por storeName (esqueci a senha / login por usuário): no máximo 1 resultado.
      allow list: if request.query.limit <= 1;
      allow delete: if false;

      // Coleções da loja sem exigência de imutabilidade.
      match /products/{productId} {
        allow read, write: if ownsStore();
      }
      match /purchases/{purchaseId} {
        allow read, write: if ownsStore();
      }
      match /paymentTerminals/{terminalId} {
        allow read, create, update: if ownsStore();
        allow delete: if false;

        // Tarifas são append-only: nunca sobrescrever/apagar o histórico.
        match /tariffs/{tariffId} {
          allow read, create: if ownsStore();
          allow update, delete: if false;
        }
      }
    }
  }
}
